{
  "name": "wordshift",
  "short_name": "wordshift",
  "description": "Three daily word games. One puzzle each, same for everyone.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
